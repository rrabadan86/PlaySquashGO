# Copie para .env e preencha no servidor. Nunca commite o .env (DAD-01).
NODE_ENV=production
DATABASE_URL=postgres://usuario:senha@localhost:5432/playsquash
# Assinatura do cookie de sessão do painel: texto aleatório com 32+ caracteres (ex.: openssl rand -hex 32).
PAINEL_SEGREDO=
PORTA=3000
# Só para testes de integração: banco de TESTE, que é apagado e recriado.
DATABASE_URL_TESTE=
# Sofia (Anthropic) — chave em conta no nome da Play Squash.
ANTHROPIC_API_KEY=
# Google Agenda: arquivo da chave da conta de serviço, FORA do repositório, legível só
# pelo usuário do sistema (AGD-09, DAD-10). Sem ele, as aulas ficam na fila até configurar.
GOOGLE_CONTA_SERVICO_ARQUIVO=
