# Copie para .env e preencha no servidor. Nunca commite o .env (DAD-01).
NODE_ENV=production
DATABASE_URL=postgres://usuario:senha@localhost:5432/playsquash
# Assinatura do cookie de sessão do painel: texto aleatório com 32+ caracteres (ex.: openssl rand -hex 32).
PAINEL_SEGREDO=
PORTA=3000
# WhatsApp (OPR-01): 1 liga o número da Play Squash (QR na tela WhatsApp do painel).
WHATSAPP_LIGADO=0
# Pasta da sessão do WhatsApp, FORA do repositório e estável entre versões (DAD-02).
WA_SESSAO_DIR=
# Opcional: fixar a versão do WhatsApp Web (.html do repositório wa-version) se o QR parar de funcionar.
WA_WEB_VERSION_URL=
# Só para testes de integração: banco de TESTE, que é apagado e recriado.
DATABASE_URL_TESTE=
# Sofia (Anthropic) — chave em conta no nome da Play Squash. Sem ela, a Sofia não responde.
ANTHROPIC_API_KEY=
# Pasta dos anexos da Sofia (imagens/PDF), FORA do repositório (DAD-02). Padrão: ~/.playsquash-anexos
SOFIA_ANEXOS_DIR=
# Google Agenda: arquivo da chave da conta de serviço, FORA do repositório, legível só
# pelo usuário do sistema (AGD-09, DAD-10). Sem ele, as aulas ficam na fila até configurar.
GOOGLE_CONTA_SERVICO_ARQUIVO=
