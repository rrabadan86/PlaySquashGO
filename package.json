{
  "name": "playsquashgo",
  "version": "0.0.1",
  "private": true,
  "description": "Play Squash — agenda das quadras, Sofia no WhatsApp, app do aluno e cobrança por Pix",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "NODE_ENV=test node --test \"testes/unidade/**/*.test.js\"",
    "test:integracao": "NODE_ENV=test node --test --test-concurrency=1 \"testes/integracao/**/*.test.js\"",
    "matriz": "node scripts/matriz.js",
    "matriz:conferir": "node scripts/matriz.js --conferir",
    "migrar": "node scripts/migrar.js",
    "test:telas": "NODE_ENV=test node --test --test-concurrency=1 \"testes/tela/**/*.test.js\"",
    "iniciar": "node src/index.js",
    "criar-usuario": "node scripts/criar-usuario.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "google-auth-library": "^9.15.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "1.34.8"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
